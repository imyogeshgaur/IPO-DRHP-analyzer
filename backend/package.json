{
  "name": "rag-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/entrypoints/server.js",
    "dev": "tsx watch src/entrypoints/server.ts",
    "worker": "node dist/entrypoints/worker.js",
    "worker:dev": "tsx watch src/entrypoints/worker.ts",
    "test": "tsx --test src/contracts/*.test.ts src/documents/*.test.ts src/infrastructure/*.test.ts src/services/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "cheerio": "^1.0.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "mammoth": "^1.9.0",
    "mongodb": "^6.12.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "resolutions": {
    "light-my-request": "6.5.0"
  }
}
