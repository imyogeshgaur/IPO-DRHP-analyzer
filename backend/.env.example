PORT=3000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=rag
MONGODB_VECTOR_INDEX=rag_vector_index
VECTOR_SEARCH_MODE=mongodb
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma4:12b-mlx
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MODEL_PROVIDER=ollama
BEDROCK_REGION=ap-south-1
BEDROCK_CHAT_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
S3_BUCKET_NAME=
MONGODB_URI_PARAMETER_NAME=
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_BYTES=20971520
UPLOAD_MODE=local

# Use local only for development. Set to cognito before exposing the API.
AUTH_MODE=local
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Optional extra guard for local development; never put this in a mobile app.
API_KEY=
